<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/app.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset</title>
</head>
<body class="bg-light">
    <div class="d-flex justify-content-center align-content-center flex-wrap">
        <div class="login_box">
            <h1>Enter your new password</h1>
            {{#if error_pw-dont-match}}
                <div class="alert alert-danger" role="alert">
                    Your entered passwords don't match!
                </div>
            {{/if}}
            {{#if error_email-invalid}}
                <div class="alert alert-danger" role="alert">
                    Your entered E-Mail seems incorrect. Please try again.
                </div>
            {{/if}}

            {{#if error_invalid-token}}
                <div class="alert alert-danger" role="alert">
                    The password reset token expired or is invalid.
                </div>
            {{else}}
                <form method="post">
                    <div class="form-group mt-3">
                        <label for="email">Email address</label>
                        <input type="email" class="form-control" name="email" id="email" aria-describedby="emailHelp" placeholder="Enter email">
                    </div>
                    <div class="form-group mt-3">
                        <label for="password">Password</label>
                        <input type="password" class="form-control" name="password" id="password" minlength="10" aria-describedby="Password" required>
                        <input type="hidden" name="token" value="{{token}}">
                    </div>
                    <div class="form-group mt-3">
                        <label for="password">Password (again)</label>
                        <input type="password" class="form-control" name="password2" id="password2" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Set new Password</button>
                </form>
            {{/if}}
        </div>
    </div>
</body>
</html>