{{> header page_name="Home" home_active=true}}

<div class="container-fluid mt-3">
    <div id="dashboard_banner_container"></div>
    <div class="row mb-1">
        <div class="col-12 d-flex align-content-center">
            <h1 class="d-inline">Projects</h1><a href="/projects/create" class="btn d-flex align-content-center btn-outline-success align-self-center ms-2" style="flex-wrap: wrap; height: 80%;">+</a>
        </div>
    </div>
    <div class="project_list">
        <div class="row list_row">
            <div class="col d-flex align-content-center flex-wrap">
                <b>Name</b>
            </div>
        </div>
        {{#each projects}}
            {{#if Folder}}
                Folders aren't supported yet.
            {{/if}}
            {{#if Project}}
                <div class="row list_row">
                    <div class="col d-flex align-content-center flex-wrap">
                        <a href="/projects/{{Project.id}}">{{Project.name}}</a>
                    </div>
                </div>
            {{/if}}
        {{/each}}
    </div>
</div>
<footer class="footer">
    <div class="container-fluid">
        <span class="text-muted">Version: {{version}}</span>
    </div>
</footer>
<script src="/js/handlebars-v4.7.8.js" type="text/javascript"></script>
<script src="/js/general.js"></script>
<script src="/js/precompiled_templates.js" type="text/javascript"></script>
<script src="/js/precompiled_partials.js" type="text/javascript"></script>
<script src="/js/runtime.js" type="text/javascript"></script>
<script src="/js/vendor.js" type="text/javascript"></script>
<script src="/js/dashboard.js" type="text/javascript"></script>
</body>
</html>