{{> header page_name="Templates" templates_active=true}}

<div class="container-fluid mt-3">
    <div class="page-toolbar mb-4">
        <h1 class="mb-0">Templates</h1>
        <div class="form-group-inline mb-0">
            <label for="templates_team_select">Team</label>
            <select id="templates_team_select" aria-label="Team" onchange="window.location.href='/templates?team_id=' + this.value">
                {{#each teams}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                {{/each}}
            </select>
        </div>
        <a href="/templates/create?team_id={{selected_team_id}}" class="btn btn-primary ms-auto" title="Create a template for this team">+ New Template</a>
    </div>
    <div class="templates_list">
        <div class="row templates_list_head">
            <div class="col-5 col-md-4">Name</div>
            <div class="col-5 col-md-6">Description</div>
            <div class="col-2" title="Export formats">Formats</div>
        </div>
        {{#each templates}}
            <a href="/templates/{{id}}" class="row templates_list_row">
                <div class="col-5 col-md-4">{{name}}</div>
                <div class="col-5 col-md-6 templates_list_description">{{description}}</div>
                <div class="col-2">{{len export_formats}}</div>
            </a>
        {{else}}
            <p class="templates_list_empty">This team has no templates yet.</p>
        {{/each}}
    </div>
</div>
<script src="/js/handlebars-v4.7.8.js" type="text/javascript"></script>
<script src="/js/precompiled_templates.js"></script>
<script src="/js/general.js"></script>
</body>
</html>
