{{> header page_name="Create Template" templates_active=true}}

<div class="container-fluid mt-3">
    <h1 class="mb-4">Create New Template</h1>
    <form class="page-panel editor-form" action="/templates/create" method="post">
        <div class="form-group">
            <label for="template_name">Name</label>
            <input type="text" id="template_name" name="name" required>
        </div>
        <div class="form-group">
            <label for="template_description">Description</label>
            <textarea id="template_description" name="description" rows="3" required></textarea>
        </div>
        <div class="form-group">
            <label for="template_team_id">Team</label>
            <select required id="template_team_id" name="team_id">
                {{#each teams}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                {{/each}}
            </select>
            <small class="text-muted mt-1">Only members of this team can see and edit the template, and only this team's projects can use it.</small>
        </div>
        <button type="submit" class="btn btn-primary">Create Template</button>
    </form>
</div>
<script src="/js/handlebars-v4.7.8.js" type="text/javascript"></script>
<script src="/js/precompiled_templates.js"></script>
<script src="/js/general.js"></script>
</body>
</html>
