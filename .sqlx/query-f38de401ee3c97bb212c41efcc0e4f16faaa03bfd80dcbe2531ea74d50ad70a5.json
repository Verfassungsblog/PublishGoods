  "query": "SELECT id, team_id, role as \"role: TeamRole\", user_id, email, timestamp, email_token FROM invitations\n           WHERE user_id = $1\n              OR (LOWER(email) = LOWER($2)\n                  AND EXISTS (SELECT 1 FROM users WHERE id = $1 AND email_verified))\n           ORDER BY timestamp",
