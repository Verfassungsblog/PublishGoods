<div class="col-12 d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Teams</h2>
    <button type="button" class="btn btn-primary" id="create_team_btn">+ Create Team</button>
</div>
{{#if pending_invitations}}
    <div class="col-12 mb-4">
        <h3>Pending Invitations</h3>
        <div id="pending_invitations_list">
            {{#each pending_invitations}}
                {{> profile_settings_teams_tab_pending_invitation_row}}
            {{/each}}
        </div>
    </div>
{{/if}}
<div class="col-12">
    <h3>Your Teams</h3>
    <div id="teams_list">
        {{#each teams}}
            {{> profile_settings_teams_tab_team_card}}
        {{else}}
            <p class="text-muted">You're not a member of any team yet.</p>
        {{/each}}
    </div>
</div>
