<h1>Delete Account</h1>
<p class="mt-3">You are going to delete your account. <span class="text-danger">All your projects, templates and data will be removed irrecoverably!</span></p>
<div class="form-group">
    <label for="delete_account_confirm_email">Enter your email address (<strong>{{email}}</strong>) to confirm deletion:</label>
    <input type="text" class="form-control" id="delete_account_confirm_email" autocomplete="off">
</div>
<button type="button" class="btn btn-danger mt-3" id="confirm_delete_account">
    Delete Account
</button>
