<h1>Delete Team</h1>
<p class="mt-3">You are going to delete the team <strong>{{name}}</strong>. <span class="text-danger">All its members and pending invitations will be removed irrecoverably!</span></p>
<div class="form-group">
    <label for="delete_team_confirm_name">Enter the team name (<strong>{{name}}</strong>) to confirm deletion:</label>
    <input type="text" id="delete_team_confirm_name" autocomplete="off">
</div>
<button type="button" class="btn btn-danger mt-3" id="confirm_delete_team">Delete Team</button>
