<div class="card mb-2" data-invitation-id="{{id}}">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <strong>{{team_name}}</strong> invited you as <span class="badge bg-secondary">{{role}}</span>
        </div>
        <div>
            <button type="button" class="btn btn-success btn-sm accept_invitation_btn">Accept</button>
            <button type="button" class="btn btn-secondary btn-sm decline_invitation_btn">Decline</button>
        </div>
    </div>
</div>
