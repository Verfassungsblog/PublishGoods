<div class="form-group">
    <label for="name">Name</label>
    <input type="text" id="name" value="{{name}}">
</div>
<div class="form-group">
    <label for="email">E-mail</label>
    <input type="email" id="email" value="{{email}}">
</div>
<div class="form-group col-6">
    <label for="new_password">New Password</label>
    <input type="password" id="new_password">
</div>
<div class="form-group col-6">
    <label for="new_password2">New Password Confirmation</label>
    <input type="password" id="new_password2">
</div>
<div class="form-group">
    <button type="button" class="btn btn-primary">Save Changes</button>
</div>
<div class="col">
    <div class="card mt-5">
        <div class="card-header bg-danger-subtle">
            Danger Zone
        </div>
        <div class="card-body">
            <p>Warning: When you're deleting your account, all your projects, templates and data will be gone forever.</p>
            <button type="button" id="delete_account" class="btn btn-danger">Delete Account</button>
        </div>
    </div>
</div>